layout {

    focus-ring {
        active-color   "#67ade4"
        inactive-color "#0a2133"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#67ade4"
        inactive-color "#0a2133"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#0a213370"
    }

    tab-indicator {
        active-color   "#67ade4"
        inactive-color "#0c548d"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#67ade480"
    }
}

recent-windows {
    highlight {
        active-color "#67ade4"
        urgent-color "#fd4663"
    }
}
